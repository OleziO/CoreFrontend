{
  "name": "core-league-vite",
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev-only": "vite --host --mode dev",
    "dev": "run-s dev-only",
    "build": "run-s type-check build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "legal:check": "node scripts/legal/check.mjs",
    "type-check": "vue-tsc --build --force",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "api": "npx openapi-typescript https://api.core-league-dota2.org/api-json -o src/api/types/schema.d.ts",
    "api:local": "npx openapi-typescript http://localhost:3000/api-json -o src/api/types/schema.d.ts",
    "api:prod-v2": "npx openapi-typescript https://v2.core-league-dota2.org/api-json -o src/api/types/schema-v2.d.ts",
    "api:stage-v2": "npx openapi-typescript https://stage-v2.core-league-dota2.org/api-json -o src/api/types/schema-v2.d.ts"
  },
  "dependencies": {
    "@phosphor-icons/vue": "^2.2.1",
    "@pinia/colada": "^0.17.8",
    "@tailwindcss/container-queries": "^0.1.1",
    "@vueuse/core": "^10.11.0",
    "axios": "^1.7.2",
    "dayjs": "^1.11.19",
    "element-plus": "^2.7.6",
    "embla-carousel-vue": "^8.6.0",
    "lucide-vue-next": "^0.552.0",
    "pinia": "^2.1.7",
    "portal-vue": "^3.0.0",
    "socket.io-client": "^4.8.4",
    "vite-svg-loader": "^5.1.0",
    "vue": "^3.4.31",
    "vue-advanced-cropper": "^2.8.9",
    "vue-gtag": "^3.7.1",
    "vue-router": "^4.4.0",
    "vue-virtual-scroller": "^2.0.0-beta.8"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.3",
    "@tsconfig/node20": "^20.1.4",
    "@types/node": "^20.14.9",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/tsconfig": "^0.5.1",
    "autoprefixer": "^10.4.19",
    "dotenv": "^16.3.1",
    "eslint": "^8.57.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-cypress": "^2.15.1",
    "eslint-plugin-vue": "^9.27.0",
    "marked": "^18.1.1",
    "npm-run-all2": "^6.2.2",
    "pathe": "^1.1.2",
    "postcss": "^8.4.39",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.93.3",
    "start-server-and-test": "^2.0.3",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.5.3",
    "unplugin-auto-import": "^0.17.6",
    "unplugin-icons": "^0.19.0",
    "unplugin-vue-components": "^0.27.2",
    "vite": "^5.3.3",
    "vue-tsc": "^2.0.26"
  }
}
