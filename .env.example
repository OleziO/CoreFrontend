# API base URL (without trailing slash).
# Used by the Axios client for all API requests including Discord OAuth.
VITE_API_PUBLIC_URL=https://localhost:3000

# IMPORTANT: Discord OAuth setup
# --------------------------------
# 1. In Discord Developer Portal → OAuth2 → Redirects, add:
#    http://localhost:5173/auth/callback   (or your production origin + /auth/callback)
#
# 2. On the NestJS backend, set DISCORD_REDIRECT_URI to the same URL:
#    DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback
#
# 3. On the NestJS backend, set CORS_ORIGINS to include this app's origin:
#    CORS_ORIGINS=http://localhost:5173
#
# No Discord client_secret is needed on the frontend — the backend handles it.
